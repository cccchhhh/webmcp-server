# Node does not auto-load .env. Use node --env-file=.env dist/cli.js serve
DEPLOYMENT_MODE=local
HOST=127.0.0.1
PORT=38472
PUBLIC_BASE_URL=http://127.0.0.1:38472
ALLOWED_HOSTS=127.0.0.1,localhost
# BRIDGE_CONFIG_FILE=/absolute/private/directory/credentials.json
TOOL_TIMEOUT_MS=60000
MAX_ARGUMENT_BYTES=262144
MAX_RESULT_BYTES=1048576
MAX_MESSAGE_BYTES=2097152
SHUTDOWN_GRACE_MS=3000
LOG_LEVEL=info
# Remote: DEPLOYMENT_MODE=remote, PUBLIC_BASE_URL=https://bridge.example.com
# ALLOWED_HOSTS=bridge.example.com,127.0.0.1,localhost
# MCP_DOMAIN=bridge.example.com
